# ===== 数据库 / Redis =====
POSTGRES_USER=lowcode
POSTGRES_PASSWORD=lowcode123
POSTGRES_DB=lowcode
DATABASE_URL=postgresql://lowcode:lowcode123@localhost:5432/lowcode?schema=public
REDIS_URL=redis://localhost:6379

# ===== 服务端口 =====
WEB_PORT=3000
SERVER_PORT=3001

# ===== 认证(JWT)=====
# 签发 token 的密钥,生产环境必须改成足够长的随机串(openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret

# ===== web 应用使用的 API 地址 =====
# 浏览器端(开发时跨端口直连 server;生产经 nginx 同源 /api)
NEXT_PUBLIC_API_URL=http://localhost:3001
# 服务端内部(SSR / 导出时回源用)
API_INTERNAL_URL=http://localhost:3001
# 静态导出 HTML 中表单提交指向的公网地址
NEXT_PUBLIC_SITE_API_URL=http://localhost
